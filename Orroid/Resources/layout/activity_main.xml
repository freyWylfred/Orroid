<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- 敵エリア (3) -->
    <FrameLayout
        android:id="@+id/enemyArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="#16213e">

        <!-- 敵とHPゲージを縦に配置 -->
        <LinearLayout
            android:id="@+id/enemyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 敵のHPゲージ（敵の上） -->
            <FrameLayout
                android:id="@+id/enemyHpBarContainer"
                android:layout_width="150dp"
                android:layout_height="12dp"
                android:layout_marginBottom="8dp"
                android:background="#333344">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#444455" />

                <View
                    android:id="@+id/enemyHpBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#ff6b6b" />

            </FrameLayout>

            <!-- 敵キャラクター -->
            <TextView
                android:id="@+id/enemyCharacter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👾"
                android:textSize="48sp" />

        </LinearLayout>

        <!-- 報酬表示（初期は非表示） -->
        <LinearLayout
            android:id="@+id/rewardContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉 VICTORY! 🎉"
                android:textColor="#FFD700"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/expRewardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXP: +100"
                android:textColor="#4CAF50"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/goldRewardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOLD: +50"
                android:textColor="#FFD700"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 区切り線 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#4a4a6a" />

    <!-- スキルエリア (7) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:background="#0f0f23"
        android:orientation="vertical">

        <!-- プレイヤーHP（数字表示） -->
        <TextView
            android:id="@+id/playerHpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="HP: 100"
            android:textColor="#4CAF50"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- スキルリスト（スクロール可能） -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/skillContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="8dp">

                <!-- 連打切り -->
                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginVertical="8dp">

                    <Orroid.CircularGaugeView
                        android:id="@+id/gaugeRapidSlash"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#80000000">

                        <Button
                            android:id="@+id/btnRapidSlash"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="連打切り"
                            android:textSize="14sp"
                            android:textColor="#ffffff"
                            android:enabled="false"
                            android:background="@android:color/transparent" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 速攻切り -->
                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginVertical="8dp">

                    <Orroid.CircularGaugeView
                        android:id="@+id/gaugeQuickSlash"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#80000000">

                        <Button
                            android:id="@+id/btnQuickSlash"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="速攻切り"
                            android:textSize="14sp"
                            android:textColor="#ffffff"
                            android:enabled="false"
                            android:background="@android:color/transparent" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 防御 -->
                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginVertical="8dp">

                    <Orroid.CircularGaugeView
                        android:id="@+id/gaugeDefense"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#80000000">

                        <Button
                            android:id="@+id/btnDefense"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="防御"
                            android:textSize="14sp"
                            android:textColor="#ffffff"
                            android:enabled="false"
                            android:background="@android:color/transparent" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>